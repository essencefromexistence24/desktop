{
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "^react$",
    "^next(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@dx/(.*)$",
    "^\\.\\./",
    "^\\./"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "tailwindFunctions": ["cn", "clsx"],
  "overrides": [
    {
      "files": "*.md",
      "options": { "parser": "markdown" }
    },
    {
      "files": "*.mdx",
      "options": { "parser": "mdx" }
    }
  ]
}
